// BrewLite Database – Prisma schema
// Nguồn: Class Domain (docs/diagrams/class-domain.puml), backend-data-design §4, ADR-002.
// Sprint 1: Catalog. Sprint 2: users (Task 5, nhánh feat/39-health-auth); orders, order_items,
// order_item_toppings, payments thêm bằng migration riêng khi chốt schema đơn hàng với Đại.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Vai trò người dùng (Class Domain: UserRole).
enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
}

/// User (Người dùng). Mật khẩu chỉ lưu dạng băm (NFR-03); email không trùng (FR-20).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("users")
}

/// Product (Đồ uống). availableQuantity = stockQuantity - reservedQuantity, tính ở API, không lưu cột.
model Product {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  description      String
  basePrice        Decimal          @map("base_price") @db.Decimal(12, 2)
  imageUrl         String?          @map("image_url")
  isActive         Boolean          @default(true) @map("is_active")
  stockQuantity    Int              @default(0) @map("stock_quantity")
  reservedQuantity Int              @default(0) @map("reserved_quantity")
  sizes            ProductSize[]
  toppings         ProductTopping[]

  @@map("products")
}

/// Size (Kích cỡ) dùng chung cho cả cửa hàng, ví dụ S, M, L.
model Size {
  id         String        @id @default(uuid()) @db.Uuid
  name       String
  extraPrice Decimal       @map("extra_price") @db.Decimal(12, 2)
  products   ProductSize[]

  @@map("sizes")
}

/// Topping.
model Topping {
  id       String           @id @default(uuid()) @db.Uuid
  name     String
  price    Decimal          @db.Decimal(12, 2)
  isActive Boolean          @default(true) @map("is_active")
  products ProductTopping[]

  @@map("toppings")
}

/// Quan hệ Product – Size (0..* – 0..*): size món được phép chọn.
model ProductSize {
  productId String  @map("product_id") @db.Uuid
  sizeId    String  @map("size_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@id([productId, sizeId])
  @@map("product_sizes")
}

/// Quan hệ Product – Topping (0..* – 0..*): topping món được phép chọn.
model ProductTopping {
  productId String  @map("product_id") @db.Uuid
  toppingId String  @map("topping_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping   Topping @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@id([productId, toppingId])
  @@map("product_toppings")
}
